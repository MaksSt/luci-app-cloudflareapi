#!/bin/sh

CONFIG_NAME='cloudflareapi'
CLOUDFLARE_API='https://api.cloudflare.com/client/v4'

json_error() {
    local code="$1"
    local message="$2"

    printf '{"success":false,"errors":[{"code":"%s","message":"%s"}],"result":[]}\n' "$code" "$message"
}

require_token() {
    token="$(uci -q get "$CONFIG_NAME.settings.token")"

    if [ -z "$token" ]; then
        json_error 'TOKEN_MISSING' 'Cloudflare API token не задан'
        exit 1
    fi
}

cloudflare_get() {
    local path="$1"

    curl -fsS --connect-timeout 10 --max-time 30 \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" \
        "$CLOUDFLARE_API$path"
}

case "$1" in
    save)
        uci commit "$CONFIG_NAME"
        /etc/init.d/cloudflareapi reload >/dev/null 2>&1 || true
        printf '{"success":true}\n'
    ;;
    zones)
        require_token
        page="${2:-1}"

        case "$page" in
            ''|*[!0-9]*|0)
                json_error 'PAGE_INVALID' 'page должен быть положительным числом'
                exit 1
            ;;
        esac

        cloudflare_get "/zones?page=$page&per_page=50"
    ;;
    records)
        require_token

        if [ -z "$2" ]; then
            json_error 'ZONE_ID_MISSING' 'zone_id обязателен'
            exit 1
        fi

        page="${3:-1}"
        case "$page" in
            ''|*[!0-9]*|0)
                json_error 'PAGE_INVALID' 'page должен быть положительным числом'
                exit 1
            ;;
        esac

        cloudflare_get "/zones/$2/dns_records?page=$page&per_page=50"
    ;;
    *)
        json_error 'UNKNOWN_COMMAND' 'Неизвестная команда'
        exit 1
    ;;
esac
