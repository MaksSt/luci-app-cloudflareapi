#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

service_enabled() {
    [ "$(uci -q get cloudflareapi.settings.enabled)" = "1" ]
}

start_service() {
    service_enabled || return 0

    procd_open_instance
    procd_set_param command /usr/bin/cloudflareapi-scheduler
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

boot() {
    start

    if service_enabled && [ "$(uci -q get cloudflareapi.settings.check_on_boot)" = "1" ]; then
        /usr/bin/cloudflareapi-check boot >/dev/null 2>&1 &
    fi
}

reload_service() {
    stop
    start
}
